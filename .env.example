# Root-level example env file for reference.
#
# docker-compose.yml currently loads its actual environment from
# server/.env (see the env_file entries for the "db" and "backend"
# services) — copy server/.env.example to server/.env to run the stack.
# This file documents the same variables for anyone working outside Docker.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=youngmoney
POSTGRES_USER=youngmoney
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

CARDAPI_KEY=
GEMINI_API_KEY=
