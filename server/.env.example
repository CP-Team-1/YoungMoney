# Copy this file to server/.env for local development.
# server/.env is gitignored and is loaded by both the "db" and "backend"
# services in docker-compose.yml (see env_file: ./server/.env).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Set to True only once TLS termination is in place in front of the app
# (nginx or a load balancer forwarding X-Forwarded-Proto).
DJANGO_USE_HTTPS=False

# --- Postgres ---
# These same values are consumed by the official postgres image (POSTGRES_DB /
# POSTGRES_USER / POSTGRES_PASSWORD) and by Django's DATABASES setting.
POSTGRES_DB=youngmoney
POSTGRES_USER=youngmoney
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS ---
# Comma-separated list of origins allowed to call the API (Vite dev server,
# nginx-served frontend, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# --- Third-party APIs ---
CARDAPI_KEY=
GEMINI_API_KEY=
